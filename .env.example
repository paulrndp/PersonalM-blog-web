# Central Backend REST API URL
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Database Connection (Optional if connecting directly via Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/hannahm_db?schema=public"

# Auth Secret for session encryption (at least 32 characters)
AUTH_SECRET="replace-with-a-secure-random-32-character-secret"

# Web Port
PORT=3000
